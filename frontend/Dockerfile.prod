# Stage 1: Build Node.js / Vite
FROM node:20-alpine AS builder

WORKDIR /usr/src/app

# Definimos variables que pasaremos desde docker-compose
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL

# Copiar dependencias primero para cacheo de capas
COPY package*.json ./
RUN npm ci

# Copiar código fuente
COPY . .

# Compilar la aplicación React para producción
RUN npm run build

# Stage 2: Servir con Caddy (HTTPS automático, seguro por defecto)
FROM caddy:2-alpine

# Copiar la configuración de Caddy
COPY Caddyfile /etc/caddy/Caddyfile

# Copiar archivos compilados del builder al directorio raíz de Caddy (/srv)
COPY --from=builder /usr/src/app/dist /srv

# Exponer HTTP y HTTPS
EXPOSE 80 443 443/udp

# Caddy inicia con su propio comando por defecto
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
