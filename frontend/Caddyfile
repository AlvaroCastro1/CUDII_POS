# ============================================================
# Caddyfile — CUDII POS Frontend
# Caddy maneja HTTPS automáticamente vía Let's Encrypt.
# Cuando CADDY_HOST sea un dominio real (ej. app.micudii.com),
# Caddy obtendrá y renovará el certificado SSL sin configuración extra.
# Para IP pública o localhost, usa http://
# ============================================================

{$CADDY_HOST:http://:80}

# ── Encabezados de Seguridad ─────────────────────────────────
header {
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    -Server
    -X-Powered-By
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
}

# ── Bloqueo de Rutas Sensibles ───────────────────────────────
@archivos_sensibles {
    path /.env*
    path /.git*
    path /prisma/*
    path /node_modules/*
    path /src/*
    path *.sql
    path *.ts
    path *.tsx
    path */.DS_Store
    path /package*.json
    path /tsconfig*
    path /vite.config*
    path /Dockerfile*
    path /docker-compose*
}
respond @archivos_sensibles 403

# ── Proxy Inverso → Archivos Subidos ────────────────────────
# Sirve logos y adjuntos desde el volumen del backend.
handle /uploads/* {
    reverse_proxy api:3000
}

# ── Proxy Inverso → API NestJS ───────────────────────────────
# Elimina el prefijo /api antes de enviar la solicitud al backend.
handle /api/* {
    uri strip_prefix /api
    reverse_proxy api:3000
}

# ── Servidor de Archivos Estáticos (React SPA) ───────────────
handle {
    root * /srv
    encode zstd gzip
    try_files {path} /index.html
    file_server {
        browse off
    }
}
