// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------
// MODELO MULTITENANT (Nivel de Empresa/Organización)
// ---------------------------------------------------------

model Empresa {
  id                    String     @id @default(uuid())
  nombre                String
  rfc                   String?
  modoCorteZ            ModoCorteZ @default(ciego)
  umbralFaltanteCritico Float      @default(50.0) // Monto ($) a partir del cual un faltante se considera crítico y requiere autorización
  diasCaducidadPreaviso Int        @default(30) // Días de anticipación para alertar lotes por vencer
  bloquearVentaVencidos Boolean    @default(true) // Si un lote vencido bloquea su venta en el POS
  stockMinimoGlobal     Int        @default(5) // Stock mínimo default al crear productos nuevos
  stockMaximoGlobal     Int        @default(100) // Stock máximo default al crear productos nuevos

  // D12: Presupuestos. Determina si al vender un presupuesto se conserva el
  // precio congelado o se recalculan los precios actuales del catálogo.
  conservarPrecioPresupuesto Boolean @default(true)
  secuenciaPresupuesto       Int     @default(0) // Folio atómico por empresa (P-000001)
  // D12: días que un presupuesto conserva su precio congelado antes de vencerse.
  // 0 = sin vencimiento (el precio se conserva según conservarPrecioPresupuesto).
  diasExpiracionPresupuesto Int @default(0)

  secuenciaSolicitudProveedor Int @default(0) // Folio atómico por empresa para solicitudes a proveedores (SOL-000001)
  secuenciaTraspaso          Int @default(0) // Folio atómico por empresa para traspasos entre sucursales (TRASP-000001)

  // Configuración y personalización de estilo de tickets (Ventas y Presupuestos)
  configuracionTicket Json?

  // Whitelabel: personalización completa de identidad visual por empresa/tenant
  // (colores, tipografía, logos, favicon, comportamiento de UI)
  configuracionWhitelabel Json?

  estaActivo            Boolean    @default(true)
  creadoEn              DateTime   @default(now())
  actualizadoEn         DateTime   @updatedAt

  // Relaciones
  sucursales     Sucursal[]
  usuarios       Usuario[]
  productos      Producto[]
  categorias     Categoria[]
  ventas         Venta[]
  logsActividad  LogActividad[]
  notificaciones Notificacion[]
  lotes          Lote[]
  recepciones    RecepcionMercancia[]
  mermas         Merma[]
  proveedores    Proveedor[]
  clientes       Cliente[]
  programaLealtad ProgramaLealtad?
  cupones        Cupon[]
  combos         Combo[]
  presupuestos   Presupuesto[]
  solicitudesProveedor SolicitudProveedor[]
  traspasos      Traspaso[]
}

enum ModoCorteZ {
  ciego
  abierto
}

// ---------------------------------------------------------
// SUCURSALES Y CAJAS
// ---------------------------------------------------------

model Sucursal {
  id         String   @id @default(uuid())
  empresaId  String
  empresa    Empresa  @relation(fields: [empresaId], references: [id])
  nombre     String
  estaActivo Boolean  @default(true)
  creadoEn   DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  // Relaciones
  cajas                 Caja[]
  inventario            InventarioSucursal[]
  ventas                Venta[]
  lotes                 Lote[]
  recepciones           RecepcionMercancia[]
  mermas                Merma[]
  movimientosInventario MovimientoInventario[]
  traspasosOrigen       Traspaso[] @relation("traspasosOrigen")
  traspasosDestino      Traspaso[] @relation("traspasosDestino")

  @@index([empresaId])
}

model Caja {
  id             String   @id @default(uuid())
  sucursalId     String
  sucursal       Sucursal @relation(fields: [sucursalId], references: [id])
  nombre         String
  secuenciaFolio Int      @default(0) // Secuencia de folios para esta caja
  estaActivo     Boolean  @default(true)
  creadoEn       DateTime @default(now())
  actualizadoEn  DateTime @updatedAt

  // Relaciones
  sesiones SesionCaja[]
  ventas   Venta[]

  @@index([sucursalId])
}

// ---------------------------------------------------------
// USUARIOS Y RBAC
// ---------------------------------------------------------

model Usuario {
  id            String   @id @default(uuid())
  empresaId     String
  empresa       Empresa  @relation(fields: [empresaId], references: [id])
  nombre        String
  email         String   @unique
  passwordHash  String
  rol           Rol      @default(CAJERO)
  estaActivo    Boolean  @default(true)

  // #10: layout personalizable del dashboard (orden, tamaños, widgets ocultos y TODOs)
  preferenciasDashboard Json?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  // Relaciones
  movimientosInventario   MovimientoInventario[]
  sesionesCaja            SesionCaja[]
  retirosParciales        RetiroParcial[]
  cortesX                 CorteX[]
  cortesZ                 CorteZ[]
  cortesZAutorizados      CorteZ[]               @relation("cortesZAutorizados")
  ventas                  Venta[]
  devoluciones            Devolucion[]
  logsActividad           LogActividad[]
  notificacionesRecibidas Notificacion[]         @relation("notificacionesRecibidas")
  lotesCreados            Lote[]                 @relation("lotesCreados")
  recepciones             RecepcionMercancia[]
  mermasRegistradas       Merma[]                @relation("mermasRegistradas")
  abonosCredito           AbonoCredito[]
  solicitudesProveedorCreadas SolicitudProveedor[] @relation("solicitudesProveedorCreadas")
  combosCreados           Combo[]             @relation("combosCreados")
  presupuestosCreados     Presupuesto[]       @relation("presupuestosCreados")
  traspasosCreados        Traspaso[]          @relation("traspasosCreados")
  traspasosRecibidos      Traspaso[]          @relation("traspasosRecibidos")
  egresosCaja             EgresoCaja[]

  @@index([empresaId])
}

enum Rol {
  SUPER_ADMIN
  ADMIN
  GERENTE
  CAJERO
  ALMACEN
  CONTADOR
}

// ---------------------------------------------------------
// PRODUCTOS Y CATÁLOGO
// ---------------------------------------------------------

model Producto {
  id            String  @id @default(uuid())
  empresaId     String
  empresa       Empresa @relation(fields: [empresaId], references: [id])
  codigoBarras  String
  codigoInterno String?
  nombre        String
  descripcion   String?

  unidadMedida     String         @default("pieza")
  estaActivo       Boolean        @default(true)
  esGranel         Boolean        @default(false)
  manejaInventario Boolean        @default(true) // true => SIEMPRE trazabilidad por lote (FEFO/FIFO)
  tieneCaducidad   Boolean        @default(false) // true => fechaCaducidad obligatoria en GRN
  metodoRotacion   MetodoRotacion @default(FEFO) // FEFO: primero lo que caduca antes; FIFO: primero lo que entra

  precioCompra    Float @default(0)
  precioVentaBase Float @default(0)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  // Relaciones
  categorias           Categoria[]
  preciosPorUnidad     PrecioPorUnidad[]
  inventario           InventarioSucursal[]
  movimientos          MovimientoInventario[]
  detallesVenta        DetalleVenta[]
  devolucionesProducto DevolucionProducto[]
  lotes                Lote[]
  recepcionesDetalle   RecepcionDetalle[]
  mermas               Merma[]
  combos               ComboProducto[]
  detallesPresupuesto  PresupuestoDetalle[]
  detallesSolicitudProveedor SolicitudProveedorDetalle[]
  traspasoDetalles     TraspasoDetalle[]

  @@index([empresaId, estaActivo])
  @@index([empresaId, codigoBarras])
}

model PrecioPorUnidad {
  id                String   @id @default(uuid())
  productoId        String
  producto          Producto @relation(fields: [productoId], references: [id])
  unidad            String // 'pieza', 'kilogramo', 'caja', etc.
  nombreAlternativo String?
  cantidadMinima    Float
  cantidadMaxima    Float?
  precio            Float
  esDefault         Boolean  @default(false)

  @@index([productoId])
}

// ---------------------------------------------------------
// INVENTARIO Y MOVIMIENTOS
// ---------------------------------------------------------

model InventarioSucursal {
  id         String   @id @default(uuid())
  sucursalId String
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id])
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id])

  stockActual Float @default(0)
  stockMinimo Float @default(0)
  stockMaximo Float @default(100)

  ultimoMovimiento DateTime @default(now())
  creadoEn         DateTime @default(now())
  actualizadoEn    DateTime @updatedAt

  @@unique([sucursalId, productoId])
}

model MovimientoInventario {
  id            String                   @id @default(uuid())
  productoId    String
  producto      Producto                 @relation(fields: [productoId], references: [id])
  sucursalId    String
  sucursal      Sucursal                 @relation(fields: [sucursalId], references: [id])
  loteId        String?
  lote          Lote?                    @relation(fields: [loteId], references: [id])
  tipo          TipoMovimientoInventario
  cantidad      Float
  stockAnterior Float                    @default(0)
  stockNuevo    Float                    @default(0)
  referencia    String? // ID de venta, traspaso
  motivo        String                   @default("")
  usuarioId     String
  usuario       Usuario                  @relation(fields: [usuarioId], references: [id])
  fechaHora     DateTime                 @default(now())

  @@index([productoId])
  @@index([loteId])
  @@index([sucursalId])
  @@index([usuarioId])
  @@index([fechaHora])
}

model Categoria {
  id            String   @id @default(uuid())
  empresaId     String
  empresa       Empresa  @relation(fields: [empresaId], references: [id])
  nombre        String
  descripcion   String?
  colorHex      String?
  icono         String?
  estaActivo    Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  productos Producto[]

  @@index([empresaId])
}

enum TipoMovimientoInventario {
  venta
  devolucion_venta
  ajuste_positivo
  ajuste_negativo
  traspaso_salida
  traspaso_entrada
  compra
  apertura_inicial
  merma
  ENTRADA_COMPRA
  SALIDA_TRASPASO
  ENTRADA_TRASPASO
}

// ---------------------------------------------------------
// LOTES, CADUCIDADES Y MERMA
// ---------------------------------------------------------

enum EstadoLote {
  activo
  agotado
  vencido
}

enum MetodoRotacion {
  FIFO
  FEFO
}

enum MotivoMerma {
  caducado
  danado
  robo
  perdida
  error
  otro
}

model Lote {
  id         String   @id @default(uuid())
  empresaId  String
  empresa    Empresa  @relation(fields: [empresaId], references: [id])
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id])
  sucursalId String
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id])

  codigoLote       String // Código único (auto-generado si no se captura)
  fechaRecepcion   DateTime   @default(now())
  fechaFabricacion DateTime?
  fechaCaducidad   DateTime? // null = sin caducidad
  cantidadInicial  Float
  cantidadRestante Float
  costoUnitario    Float
  proveedor        String? // Nombre libre del proveedor (legacy)
  proveedorId      String?
  proveedorRef     Proveedor? @relation(fields: [proveedorId], references: [id])

  estado      EstadoLote @default(activo)
  creadoPorId String
  creadoPor   Usuario    @relation("lotesCreados", fields: [creadoPorId], references: [id])

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  // Relaciones
  movimientos          MovimientoInventario[]
  detallesVenta        DetalleVentaLote[]
  mermas               Merma[]
  devolucionesProducto DevolucionProducto[]
  traspasoDetalles     TraspasoDetalle[]

  @@index([sucursalId, productoId, fechaCaducidad])
  @@index([empresaId, estado])
  @@index([productoId])
}

model RecepcionMercancia {
  id         String   @id @default(uuid())
  empresaId  String
  empresa    Empresa  @relation(fields: [empresaId], references: [id])
  sucursalId String
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id])
  solicitudProveedorId String?
  solicitudProveedor   SolicitudProveedor? @relation(fields: [solicitudProveedorId], references: [id])
  folioFacturaProveedor String?

  folio      String
  proveedor  String?
  notas      String?
  usuarioId  String
  usuario    Usuario  @relation(fields: [usuarioId], references: [id])
  fechaHora  DateTime @default(now())

  detalles RecepcionDetalle[]

  @@index([empresaId])
  @@index([sucursalId])
  @@index([usuarioId])
  @@index([solicitudProveedorId])
}

model RecepcionDetalle {
  id          String             @id @default(uuid())
  recepcionId String
  recepcion   RecepcionMercancia @relation(fields: [recepcionId], references: [id])
  productoId  String
  producto    Producto           @relation(fields: [productoId], references: [id])

  cantidad         Float
  costoUnitario    Float
  codigoLote       String? // null => se genera automáticamente
  fechaFabricacion DateTime?
  fechaCaducidad   DateTime?

  @@index([recepcionId])
  @@index([productoId])
}

model DetalleVentaLote {
  id             String       @id @default(uuid())
  detalleVentaId String
  detalleVenta   DetalleVenta @relation(fields: [detalleVentaId], references: [id])
  loteId         String
  lote           Lote         @relation(fields: [loteId], references: [id])

  cantidad      Float
  costoUnitario Float
  creadoEn      DateTime @default(now())

  @@index([detalleVentaId])
  @@index([loteId])
}

model Merma {
  id         String   @id @default(uuid())
  empresaId  String
  empresa    Empresa  @relation(fields: [empresaId], references: [id])
  sucursalId String
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id])
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id])
  loteId     String?
  lote       Lote?    @relation(fields: [loteId], references: [id])

  cantidad      Float
  motivo        MotivoMerma
  costoUnitario Float
  costoTotal    Float
  notas         String?
  usuarioId     String
  usuario       Usuario     @relation("mermasRegistradas", fields: [usuarioId], references: [id])
  fechaHora     DateTime    @default(now())

  @@index([empresaId])
  @@index([sucursalId, productoId])
  @@index([loteId])
  @@index([usuarioId])
  @@index([fechaHora])
}

// ---------------------------------------------------------
// CAJA Y SESIONES DE TURNO
// ---------------------------------------------------------

model SesionCaja {
  id       String  @id @default(uuid())
  cajaId   String
  caja     Caja    @relation(fields: [cajaId], references: [id])
  cajeroId String
  cajero   Usuario @relation(fields: [cajeroId], references: [id])

  montoInicial          Float // Fondo inicial en efectivo
  montoFinalEfectivo    Float? // Declarado por el cajero al cerrar
  montoEsperadoEfectivo Float? // Calculado por el sistema al cerrar
  diferenciaEfectivo    Float? // montoFinalEfectivo - montoEsperadoEfectivo

  modoCorteUsado ModoCorteZ @default(ciego)

  totalVentasEfectivo Float @default(0)
  totalVentasTarjeta  Float @default(0)
  totalVentasOtros    Float @default(0)
  totalRetiros        Float @default(0)
  totalEgresos        Float @default(0)

  estado EstadoSesionCaja @default(abierta)

  fechaApertura DateTime  @default(now())
  fechaCierre   DateTime?
  actualizadoEn DateTime   @updatedAt

  // Relaciones
  ventas  Venta[]
  retiros RetiroParcial[]
  egresos EgresoCaja[]
  cortesX CorteX[]
  corteZ  CorteZ?

  @@index([cajaId, estado])
  @@index([cajeroId])
}

enum EstadoSesionCaja {
  abierta
  cerrada
}

model RetiroParcial {
  id           String     @id @default(uuid())
  sesionCajaId String
  sesionCaja   SesionCaja @relation(fields: [sesionCajaId], references: [id])
  usuarioId    String
  usuario      Usuario    @relation(fields: [usuarioId], references: [id])
  monto        Float
  motivo       String
  fechaHora    DateTime   @default(now())

  @@index([sesionCajaId])
  @@index([usuarioId])
}


model CorteX {
  id                  String     @id @default(uuid())
  sesionCajaId        String
  sesionCaja          SesionCaja @relation(fields: [sesionCajaId], references: [id])
  usuarioId           String
  usuario             Usuario    @relation(fields: [usuarioId], references: [id])
  montoInicial        Float
  totalVentasEfectivo Float
  totalVentasTarjeta  Float
  montoRetiros        Float
  totalEgresos        Float      @default(0)
  efectivoEnCaja      Float
  fechaHora           DateTime   @default(now())

  @@index([sesionCajaId])
  @@index([usuarioId])
}

model CorteZ {
  id           String     @id @default(uuid())
  sesionCajaId String     @unique
  sesionCaja   SesionCaja @relation(fields: [sesionCajaId], references: [id])
  usuarioId    String
  usuario      Usuario    @relation(fields: [usuarioId], references: [id])

  montoInicial        Float
  totalVentasEfectivo Float
  totalVentasTarjeta  Float
  totalRetiros        Float
  totalEgresos        Float      @default(0)
  montoEsperado       Float
  montoDeclarado      Float
  diferencia          Float
  tipoDiscrepancia    String? // 'cuadre', 'sobrante', 'faltante'
  modoCorte           ModoCorteZ
  notas               String?

  // Autorización requerida para faltantes críticos
  autorizadoPorId String?
  autorizadoPor   Usuario? @relation("cortesZAutorizados", fields: [autorizadoPorId], references: [id])

  fechaHora DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([usuarioId])
  @@index([autorizadoPorId])
}

// ---------------------------------------------------------
// VENTAS Y TRANSACCIONES
// ---------------------------------------------------------

model Venta {
  id           String     @id @default(uuid())
  empresaId    String
  empresa      Empresa    @relation(fields: [empresaId], references: [id])
  sucursalId   String
  sucursal     Sucursal   @relation(fields: [sucursalId], references: [id])
  cajaId       String
  caja         Caja       @relation(fields: [cajaId], references: [id])
  sesionCajaId String
  sesionCaja   SesionCaja @relation(fields: [sesionCajaId], references: [id])
  cajeroId     String
  cajero       Usuario    @relation(fields: [cajeroId], references: [id])
  clienteId    String?
  cliente      Cliente?   @relation(fields: [clienteId], references: [id])

  folio          String // Ej: "CJ01-000001"
  secuenciaFolio Int // Secuencial numérico per caja

  subtotal  Float
  descuento Float @default(0)
  impuestos Float @default(0)
  total     Float

  // Desglose del descuento total (#5): nivel de lealtad, canje de puntos y cupón
  descuentoNivel Float @default(0)
  descuentoCanje Float @default(0)
  descuentoCupon Float @default(0)

  estado         EstadoVenta @default(completada)
  esDemostracion Boolean     @default(false)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  detalles          DetalleVenta[]
  pagos             PagoVenta[]
  devoluciones      Devolucion[]
  ventaCredito      VentaCredito?
  movimientosPuntos MovimientoPuntos[]
  cuponRedencion    CuponRedencion?

  @@unique([empresaId, folio])
  @@index([empresaId, creadoEn])
  @@index([sucursalId, creadoEn])
  @@index([sesionCajaId])
  @@index([cajeroId])
  @@index([cajaId])
  @@index([clienteId])
}

enum EstadoVenta {
  completada
  cancelada
  reembolsada
}

model DetalleVenta {
  id         String   @id @default(uuid())
  ventaId    String
  venta      Venta    @relation(fields: [ventaId], references: [id])
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id])

  // D11: marco del combo al que pertenece la línea (snapshot del nombre)
  comboId      String?
  combo        Combo?  @relation(fields: [comboId], references: [id])
  nombreCombo  String?

  nombreProducto String // Snapshot del nombre al momento de venta
  unidadMedida   String // 'pieza', 'kilogramo', etc.
  cantidad       Float
  precioUnitario Float
  costoHistorico Float  @default(0) // Snapshot del costo (promedio ponderado de lotes)
  subtotal       Float
  descuento      Float  @default(0)
  impuestos      Float  @default(0)
  total          Float

  creadoEn DateTime @default(now())

  lotes DetalleVentaLote[]

  @@index([ventaId])
  @@index([productoId])
  @@index([comboId])
}

model PagoVenta {
  id            String     @id @default(uuid())
  ventaId       String
  venta         Venta      @relation(fields: [ventaId], references: [id])
  metodo        MetodoPago
  montoRecibido Float
  montoPagado   Float
  cambio        Float      @default(0)
  referencia    String? // Ej: Autorización de tarjeta
  creadoEn      DateTime @default(now())

  @@index([ventaId])
}

enum MetodoPago {
  efectivo
  tarjeta
  transferencia
  voucher
  credito
}

// ---------------------------------------------------------
// CUPONES DE DESCUENTO
// ---------------------------------------------------------

enum TipoDescuentoCupon {
  PORCENTAJE
  MONTO_FIJO
}

model Cupon {
  id        String  @id @default(uuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  codigo      String // Código alfanumérico que escribe el cajero (ej. VERANO2026)
  nombre      String
  descripcion String?

  tipoDescuento  TipoDescuentoCupon
  valorDescuento Float // % (si PORCENTAJE) o monto en $ (si MONTO_FIJO)

  // Condiciones de aplicación
  montoMinimoCompra        Float?  // Monto mínimo de compra (base) para poder aplicarlo
  soloClientesRegistrados  Boolean @default(false) // Exige cliente registrado

  // Límites de uso ("primeras N personas... hasta agotar existencias")
  limiteUsosTotal         Int? // Máximo total de redemptions (null = ilimitado)
  limiteUsosPorCliente    Int? // Máximo de usos por cliente (null = ilimitado)

  // Vigencia (rango de fechas)
  fechaInicio DateTime
  fechaFin    DateTime?

  activo      Boolean @default(true)
  creadoEn    DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  redenciones CuponRedencion[]

  @@unique([empresaId, codigo])
  @@index([empresaId])
  @@index([empresaId, activo])
}

model CuponRedencion {
  id      String @id @default(uuid())
  cuponId String
  cupon   Cupon  @relation(fields: [cuponId], references: [id])
  ventaId String @unique
  venta   Venta  @relation(fields: [ventaId], references: [id])

  clienteId      String?
  montoDescuento Float
  creadoEn       DateTime @default(now())

  @@index([cuponId])
  @@index([cuponId, clienteId])
}

// ---------------------------------------------------------
// COMBOS Y PAQUETES (Promociones)
// ---------------------------------------------------------

enum TipoPrecioCombo {
  MONTO_FIJO // Precio fijo del paquete ($)
  DESCUENTO_PCT // Descuento % sobre la suma de precios individuales
}

model Combo {
  id          String         @id @default(uuid())
  empresaId   String
  empresa     Empresa        @relation(fields: [empresaId], references: [id])
  nombre      String
  descripcion String?
  tipoPrecio  TipoPrecioCombo @default(MONTO_FIJO)
  valorPrecio Float // $ fijo del paquete (MONTO_FIJO) o % de descuento (DESCUENTO_PCT)

  activo      Boolean @default(true)
  fechaInicio DateTime?
  fechaFin    DateTime?

  creadoPorId String
  creadoPor   Usuario @relation("combosCreados", fields: [creadoPorId], references: [id])

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  productos     ComboProducto[]
  detallesVenta DetalleVenta[]
  detallesPresupuesto PresupuestoDetalle[]

  @@index([empresaId, activo])
  @@index([empresaId, fechaInicio, fechaFin])
}

model ComboProducto {
  id         String   @id @default(uuid())
  comboId    String
  combo      Combo    @relation(fields: [comboId], references: [id])
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id])
  cantidad   Float

  @@unique([comboId, productoId])
}

// ---------------------------------------------------------
// DEVOLUCIONES
// ---------------------------------------------------------

model Devolucion {
  id           String  @id @default(uuid())
  ventaId      String
  venta        Venta   @relation(fields: [ventaId], references: [id])
  usuarioId    String
  usuario      Usuario @relation(fields: [usuarioId], references: [id])
  sesionCajaId String?

  folio          String // Ej: "DEV-000001"
  totalDevuelto  Float
  tipoResolucion TipoResolucionDevolucion
  motivoGeneral  String?
  fechaHora      DateTime                 @default(now())
  actualizadoEn  DateTime                 @updatedAt

  productos DevolucionProducto[]

  @@index([ventaId])
  @@index([fechaHora])
  @@index([usuarioId])
}

enum TipoResolucionDevolucion {
  reembolso_efectivo
  cambio_fisico
  saldo_favor
}

model DevolucionProducto {
  id           String     @id @default(uuid())
  devolucionId String
  devolucion   Devolucion @relation(fields: [devolucionId], references: [id])
  productoId   String
  producto     Producto   @relation(fields: [productoId], references: [id])
  loteId       String? // Lote al que se reintegra (destino stock) o del que se da de baja (destino merma)
  lote         Lote?      @relation(fields: [loteId], references: [id])

  cantidadDevuelta Float
  precioUnitario   Float
  subtotal         Float
  motivo           MotivoDevolucion
  destino          DestinoDevolucion
  creadoEn         DateTime @default(now())

  @@index([devolucionId])
  @@index([loteId])
}

enum MotivoDevolucion {
  cambio_opinion
  cambio_talla
  danado
  caducado
  error_cobro
}

enum DestinoDevolucion {
  stock
  merma
}

// ---------------------------------------------------------
// AUDITORÍA Y LOGS DE ACTIVIDAD
// ---------------------------------------------------------

model LogActividad {
  id         String  @id @default(uuid())
  empresaId  String
  empresa    Empresa @relation(fields: [empresaId], references: [id])
  sucursalId String?
  usuarioId  String
  usuario    Usuario @relation(fields: [usuarioId], references: [id])

  accion      String // 'APERTURA_CAJA', 'RETIRO_PARCIAL', 'CORTE_X', 'CORTE_Z', 'VENTA_COMPLETADA', 'VENTA_CANCELADA'
  entidadTipo String // 'sesion_caja', 'venta', 'retiro_parcial', 'corte_z', 'corte_x'
  entidadId   String // UUID de la entidad afectada
  detalles    Json // Payload completo del evento (montos, diferencias, justificación, etc.)
  severidad   String @default("info") // 'info', 'warning', 'critical'

  fechaHora DateTime @default(now())

  @@index([empresaId])
  @@index([usuarioId])
  @@index([entidadTipo, entidadId])
  @@index([fechaHora])
}

// ---------------------------------------------------------
// ---------------------------------------------------------
// PROVEEDORES
// ---------------------------------------------------------

model Proveedor {
  id        String  @id @default(uuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  nombre     String
  rfc        String?
  telefono   String?
  email      String?
  direccion  String?
  contacto   String? // Nombre del contacto principal
  notas      String?
  estaActivo Boolean @default(true)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  // Relaciones
  lotes Lote[]
  solicitudesProveedor SolicitudProveedor[]

  @@index([empresaId])
  @@index([empresaId, estaActivo])
}

// NOTIFICACIONES INTERNAS
// ---------------------------------------------------------

model Notificacion {
  id             String  @id @default(uuid())
  empresaId      String
  empresa        Empresa @relation(fields: [empresaId], references: [id])
  destinatarioId String
  destinatario   Usuario @relation("notificacionesRecibidas", fields: [destinatarioId], references: [id])

  titulo      String
  mensaje     String
  tipo        String // 'info', 'warning', 'critical'
  evento      String // 'corte_z_realizado', 'caja_abierta', 'faltante_caja', 'retiro_parcial', 'venta_cancelada'
  entidadTipo String? // Referencia opcional a la entidad relacionada
  entidadId   String? // UUID de la entidad relacionada
  leida       Boolean  @default(false)
  fechaHora   DateTime @default(now())

  @@index([destinatarioId, leida])
  @@index([empresaId])
  @@index([fechaHora])
}

// ---------------------------------------------------------
// CLIENTES, LEALTAD Y CRÉDITO (FIADOS)
// ---------------------------------------------------------

model Cliente {
  id        String  @id @default(uuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  nombre          String
  apellidoPaterno String?
  email           String?
  telefono        String?
  rfc             String?

  // Programa de lealtad
  puntosActuales   Int            @default(0)
  puntosHistoricos Int            @default(0)
  nivelLealtadId   String?
  nivelLealtad     NivelLealtad?  @relation(fields: [nivelLealtadId], references: [id])

  estaActivo    Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  // Relaciones
  ventas            Venta[]
  cuentaCredito     CuentaCreditoCliente?
  ventasCredito     VentaCredito[]
  movimientosPuntos MovimientoPuntos[]
  presupuestos      Presupuesto[]

  @@index([empresaId])
  @@index([empresaId, estaActivo])
  @@index([nivelLealtadId])
}

enum BasePuntos {
  CON_DESCUENTO
  SIN_DESCUENTO
}

// Configuración del programa de lealtad por empresa (editable desde Configuración del sitio)
model ProgramaLealtad {
  id        String  @id @default(uuid())
  empresaId String  @unique
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  habilitado Boolean @default(true)

  // Reglas de acumulación de puntos
  puntosPorMonto        Float      @default(10) // Cada $X de compra equivalen a 1 punto
  montoMinimoParaPuntos Float      @default(0)  // Venta mínima ($) para ganar puntos
  basePuntos            BasePuntos @default(CON_DESCUENTO) // Base sobre la que se calculan los puntos

  // Canje (redención) de puntos
  permitirCanje     Boolean @default(false)
  puntosPorPesos    Float   @default(100) // Cuántos puntos equivalen a $1 canjeable
  canjeMinimoPuntos Int     @default(100) // Mínimo de puntos para poder canjear

  // Caducidad de puntos (D11): 0 = nunca vencen
  mesesExpiracionPuntos Int @default(0)

  creadoEn      DateTime       @default(now())
  actualizadoEn DateTime       @updatedAt
  niveles       NivelLealtad[]

  @@index([empresaId])
}

// Niveles (rangos) personalizables del programa de lealtad
model NivelLealtad {
  id           String          @id @default(uuid())
  programaId   String
  programa     ProgramaLealtad @relation(fields: [programaId], references: [id])

  nombre       String // Nombre visible (ej. "Bronce", "VIP")
  umbralPuntos Int    // Puntos históricos requeridos para alcanzar el nivel
  descuentoPct Float  @default(0) // % de descuento aplicado al comprar
  colorHex     String?            // Color para badges en la interfaz
  creadoEn     DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  clientes Cliente[]

  @@index([programaId])
}

enum TipoMovimientoPuntos {
  GANADO
  CANJEADO
  EXPIRADO
  AJUSTE
}

// Historial de movimientos de puntos (D11): origen de datos para caducidad
// por lote y auditoría de cómo se ganan, gastan y vencen los puntos.
model MovimientoPuntos {
  id        String               @id @default(uuid())
  clienteId String
  cliente   Cliente              @relation(fields: [clienteId], references: [id])
  ventaId   String? // Venta que originó el movimiento (si aplica)
  venta     Venta?               @relation(fields: [ventaId], references: [id])

  tipo      TipoMovimientoPuntos
  puntos    Int // GANADO: positivo. CANJEADO/EXPIRADO/AJUSTE: negativo.

  // Solo aplica a GANADO: cuándo vence este lote. null = nunca vence.
  expiraEn DateTime?
  // Solo aplica a GANADO: puntos del lote ya consumidos (por canje o expiración),
  // usados por el cálculo FIFO de caducidad.
  puntosConsumidos Int @default(0)

  creadoEn DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([clienteId, creadoEn])
  @@index([tipo, expiraEn])
}

model CuentaCreditoCliente {
  id        String  @id @default(uuid())
  clienteId String  @unique
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  limiteCredito         Float
  saldoPendiente        Float   @default(0)
  diasMaximoVencimiento Int     @default(30)
  estaActivo            Boolean @default(true)

  creadoEn      DateTime       @default(now())
  actualizadoEn DateTime       @updatedAt
  ventasCredito VentaCredito[] @relation("VentaCreditoCuentaCredito")

  @@index([clienteId])
}

model VentaCredito {
  id        String  @id @default(uuid())
  ventaId   String  @unique
  venta     Venta   @relation(fields: [ventaId], references: [id])
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  montoTotal     Float
  montoPagado    Float         @default(0)
  saldoPendiente Float
  estado         EstadoCredito @default(pendiente)

  fechaVencimiento DateTime
  fechaLiquidacion DateTime?

  // Relaciones
  abonos AbonoCredito[]

  cuentaCreditoClienteId String?
  cuentaCreditoCliente   CuentaCreditoCliente? @relation("VentaCreditoCuentaCredito", fields: [cuentaCreditoClienteId], references: [id])

  @@index([clienteId])
  @@index([estado])
  @@index([fechaVencimiento])
}

enum EstadoCredito {
  pendiente
  parcialmente_pagada
  liquidada
  vencida
}

model AbonoCredito {
  id             String       @id @default(uuid())
  ventaCreditoId String
  ventaCredito   VentaCredito @relation(fields: [ventaCreditoId], references: [id])

  monto      Float
  metodoPago MetodoPago @default(efectivo)
  referencia String?
  notas      String?

  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  fechaHora DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([ventaCreditoId])
}

// ---------------------------------------------------------
// PRESUPUESTOS (D12)
// ---------------------------------------------------------

enum EstadoPresupuesto {
  abierto
  vendido
  cancelado
  vencido
}

model Presupuesto {
  id        String  @id @default(uuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])
  cajeroId  String
  cajero    Usuario @relation("presupuestosCreados", fields: [cajeroId], references: [id])
  clienteId String?
  cliente   Cliente? @relation(fields: [clienteId], references: [id])

  folio          String // Ej: "P-000001"
  secuenciaFolio Int    // Secuencial numérico por empresa

  estado EstadoPresupuesto @default(abierto)

  // Desglose total (snapshot al crear)
  subtotal  Float
  descuento Float @default(0)
  impuestos Float @default(0)
  total     Float
  descuentoNivel Float @default(0)
  descuentoCanje Float @default(0)
  descuentoCupon Float @default(0)

  // Snapshots de contexto (no se consumen límites al crear)
  descuentoGeneral Float @default(0)
  codigoCupon       String?
  puntosACanjear    Int    @default(0)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
  detalles PresupuestoDetalle[]

  @@unique([empresaId, folio])
  @@index([empresaId, creadoEn])
  @@index([empresaId, estado])
  @@index([clienteId])
}

model PresupuestoDetalle {
  id             String       @id @default(uuid())
  presupuestoId  String
  presupuesto    Presupuesto  @relation(fields: [presupuestoId], references: [id])
  productoId     String
  producto       Producto     @relation(fields: [productoId], references: [id])
  comboId        String?
  combo          Combo?       @relation(fields: [comboId], references: [id])
  nombreCombo    String?

  nombreProducto String // Snapshot del nombre al momento de crear el presupuesto
  unidadMedida   String
  cantidad       Float
  precioUnitario Float // Precio CONGELADO al crear
  descuento      Float @default(0) // p. ej. ahorro del combo repartido por línea
  subtotal       Float
  total          Float

  creadoEn DateTime @default(now())

  @@index([presupuestoId])
  @@index([productoId])
}

// ---------------------------------------------------------
// SOLICITUDES DE PRODUCTOS A PROVEEDORES / ORDENES DE COMPRA
// ---------------------------------------------------------

enum EstadoSolicitudProveedor {
  BORRADOR
  ENVIADA
  APROBADA
  RECHAZADA
  RECIBIDA
  CANCELADA
}

model SolicitudProveedor {
  id           String                   @id @default(uuid())
  empresaId    String
  empresa      Empresa                  @relation(fields: [empresaId], references: [id])
  
  // Proveedor Opcional (null = Solicitud Abierta / Requisición Interna)
  proveedorId  String?
  proveedor    Proveedor?               @relation(fields: [proveedorId], references: [id])

  creadoPorId  String
  creadoPor    Usuario                  @relation("solicitudesProveedorCreadas", fields: [creadoPorId], references: [id])

  folio                String                   // Ej: "SOL-000001"
  estado               EstadoSolicitudProveedor @default(BORRADOR)
  fechaEmision         DateTime                 @default(now())
  fechaEntregaEsperada DateTime?
  notas                String?
  totalEstimado        Float                    @default(0)

  // Soft Delete para auditoría e integridad referencial
  estaActivo           Boolean                  @default(true)
  eliminadoEn          DateTime?

  creadoEn     DateTime                 @default(now())
  actualizadoEn DateTime                @updatedAt

  detalles     SolicitudProveedorDetalle[]
  recepciones  RecepcionMercancia[]

  @@unique([empresaId, folio])
  @@index([empresaId, creadoEn])
  @@index([empresaId, estado])
  @@index([empresaId, estaActivo])
  @@index([proveedorId])
}

model SolicitudProveedorDetalle {
  id                   String             @id @default(uuid())
  solicitudProveedorId String
  solicitudProveedor   SolicitudProveedor @relation(fields: [solicitudProveedorId], references: [id], onDelete: Cascade)
  productoId           String
  producto             Producto           @relation(fields: [productoId], references: [id])

  nombreProducto       String             // Snapshot del nombre del producto
  unidadMedida         String             @default("pieza")
  cantidadRequerida    Float
  costoUnitarioEstimado Float             @default(0)
  subtotalEstimado     Float              @default(0)
  notas                String?

  creadoEn DateTime @default(now())

  @@index([solicitudProveedorId])
  @@index([productoId])
}

// ---------------------------------------------------------
// EGRESOS DE CAJA (D17)
// ---------------------------------------------------------

enum CategoriaEgresoCaja {
  FLETE
  LIMPIEZA
  INSUMOS
  PROPINAS
  OTROS
}

model EgresoCaja {
  id           String              @id @default(uuid())
  sesionCajaId String
  sesionCaja   SesionCaja          @relation(fields: [sesionCajaId], references: [id])
  usuarioId    String
  usuario      Usuario             @relation(fields: [usuarioId], references: [id])

  monto        Float
  categoria    CategoriaEgresoCaja @default(OTROS)
  concepto     String
  comprobanteUrl String?

  fechaHora    DateTime            @default(now())

  @@index([sesionCajaId])
  @@index([usuarioId])
}

// ---------------------------------------------------------
// TRASPASOS ENTRE SUCURSALES (D16)
// ---------------------------------------------------------

enum EstadoTraspaso {
  BORRADOR
  EN_TRANSITO
  RECIBIDO
  RECIBIDO_PARCIAL
  CANCELADO
}

model Traspaso {
  id               String         @id @default(uuid())
  empresaId        String
  empresa          Empresa        @relation(fields: [empresaId], references: [id])

  sucursalOrigenId String
  sucursalOrigen   Sucursal       @relation("traspasosOrigen", fields: [sucursalOrigenId], references: [id])
  sucursalDestinoId String
  sucursalDestino  Sucursal       @relation("traspasosDestino", fields: [sucursalDestinoId], references: [id])

  creadoPorId      String
  creadoPor        Usuario        @relation("traspasosCreados", fields: [creadoPorId], references: [id])
  recibidoPorId    String?
  recibidoPor      Usuario?       @relation("traspasosRecibidos", fields: [recibidoPorId], references: [id])

  folio            String         // Ej: "TRASP-000001"
  secuenciaFolio   Int            // Secuencial por empresa
  estado           EstadoTraspaso @default(BORRADOR)

  notasEmision     String?
  notasRecepcion   String?

  fechaSalida      DateTime?
  fechaRecepcion   DateTime?

  creadoEn         DateTime       @default(now())
  actualizadoEn    DateTime       @updatedAt

  detalles         TraspasoDetalle[]

  @@unique([empresaId, folio])
  @@index([empresaId, estado])
  @@index([sucursalOrigenId])
  @@index([sucursalDestinoId])
}

model TraspasoDetalle {
  id               String   @id @default(uuid())
  traspasoId       String
  traspaso         Traspaso @relation(fields: [traspasoId], references: [id], onDelete: Cascade)
  productoId       String
  producto         Producto @relation(fields: [productoId], references: [id])
  loteId           String?
  lote             Lote?    @relation(fields: [loteId], references: [id])

  nombreProducto   String
  unidadMedida     String   @default("pieza")
  cantidadEnviada  Float
  cantidadRecibida Float    @default(0)

  creadoEn         DateTime @default(now())

  @@index([traspasoId])
  @@index([productoId])
  @@index([loteId])
}

